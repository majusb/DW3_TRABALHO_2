{% extends "layout.njk" %}

{% block content %}
  <div id="medicoListagem" data-servidor-dw3="{{ servidorTrabalho }}">
    <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
      <div>
        <p class="page-kicker text-primary fw-semibold mb-1">Cadastro</p>
        <h1 class="h3 fw-bold mb-0">Médicos</h1>
      </div>
      <a class="btn btn-primary" href="/medico/form?oper=Cr">
        <i class="bi bi-plus-lg me-1"></i>Novo médico
      </a>
    </header>

    <div id="medicoAlert" class="alert d-none" role="alert"></div>

    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <table id="tblMedico" class="table table-striped table-hover align-middle w-100">
          <thead>
            <tr>
              <th>ID</th>
              <th>CRM</th>
              <th>Nome</th>
              <th>Telefone</th>
              <th>Especialidade</th>
              <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody></tbody>
        </table>
      </div>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="/apps/medico/vwLstMedico.js"></script>
{% endblock %}