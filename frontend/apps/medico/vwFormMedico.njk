{% extends "layout.njk" %}

{% block content %}
  <header class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <p class="page-kicker text-primary fw-semibold mb-1">Cadastro</p>
      <h1 class="h3 fw-bold mb-0">Médico</h1>
    </div>
    <a class="btn btn-outline-secondary" href="/medico">
      <i class="bi bi-arrow-left me-1"></i>Voltar
    </a>
  </header>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <form id="frmMedico" data-servidor-dw3="{{ servidorTrabalho }}">
        <input type="hidden" id="idMedico" name="idMedico">
        <input type="hidden" id="deleted" name="deleted" value="false">

        <div class="row g-3">
          <div class="col-md-4">
            <label for="crm" class="form-label">CRM</label>
            <input type="text" class="form-control" id="crm" name="crm" maxlength="20" required>
          </div>
          <div class="col-md-8">
            <label for="nomeMedico" class="form-label">Nome</label>
            <input type="text" class="form-control" id="nomeMedico" name="nomeMedico" maxlength="100" required>
          </div>
          <div class="col-md-6">
            <label for="telefone" class="form-label">Telefone</label>
            <input type="text" class="form-control" id="telefone" name="telefone" maxlength="20">
          </div>
          <div class="col-md-6">
            <label for="especialidade" class="form-label">Especialidade</label>
            <input type="text" class="form-control" id="especialidade" name="especialidade" maxlength="100">
          </div>
        </div>

        <div class="d-flex gap-2 mt-4">
          <button type="button" id="btnInserirMedico" class="btn btn-primary d-none">
            <i class="bi bi-check-lg me-1"></i>Inserir
          </button>
          <button type="button" id="btnAtualizarMedico" class="btn btn-warning d-none">
            <i class="bi bi-pencil-square me-1"></i>Atualizar
          </button>
          <button type="button" id="btnRemoverMedico" class="btn btn-danger d-none">
            <i class="bi bi-trash me-1"></i>Remover
          </button>
        </div>
      </form>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="/apps/medico/vwFormMedico.js"></script>
{% endblock %}